OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional: route every agent through Inworld Router (OpenAI-compatible) instead of OpenAI.
# The key is the Base64 credential from the Inworld Portal; LLMMODEL e.g. openai/gpt-5-mini or inworld/<router-id>.
INWORLD_API_KEY=
LLMMODEL=
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
WEATHER_API_TIMEOUT_SECONDS=5
LOCATIONIQ_ACCESS_TOKEN=
GOOGLE_CALENDAR_CREDENTIALS_FILE=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIME_ZONE=Asia/Ho_Chi_Minh
DATABASE_PATH=vehicle_guardian.db
INCIDENT_MEMORY_TTL_MINUTES=60
# "openai" (default: the LLM, via Inworld or OpenAI) or "rules" (no LLM call anywhere: live OBD analysis,
# the browser blackbox batch and the driver wording all use the rule-only text)
AGENT_MODE=openai
# Seconds before a slow LLM reply is abandoned for the rule-only assessment
AGENT_TIMEOUT_SECONDS=45
# Seconds the browser blackbox batch (/api/telemetry/batch) waits for the LLM before the rule-only assessment answers
BATCH_AGENT_TIMEOUT_SECONDS=30
# One LLM HTTP call may take this long before it fails (and the rule-only answer is used)
LLM_REQUEST_TIMEOUT_SECONDS=20
LOG_LEVEL=INFO
# "off" skips LocationIQ garage lookups (offline demos, tests)
EXTERNAL_TOOLS=on
# Detector thresholds; set per car after recording a normal drive (some engines run near 100–105 °C)
COOLANT_WARN_C=105
COOLANT_RISE_PER_MIN=3
# Driver-attention alerts: seconds to wait for the agent wording before using the rule text
DRIVER_AGENT_TIMEOUT_SECONDS=8
# Blaze Voice AI (https://api.blaze.vn). Spoken only for warning and critical alerts.
# BLAZE_SPEAKER_ID is a voice registered on the account (POST /v1/voices).
BLAZE_API_TOKEN=
BLAZE_SPEAKER_ID=
BLAZE_TTS_MODEL=v2.0_flash
BLAZE_TTS_LANGUAGE=vi
BLAZE_AUDIO_FORMAT=mp3
BLAZE_TTS_TIMEOUT_SECONDS=20
# Speech-to-text. POST /api/voice/listen appends the transcript to var/conversations/<session>.json
BLAZE_STT_MODEL=stt-async-1.5
BLAZE_STT_LANGUAGE=vi
BLAZE_STT_TIMEOUT_SECONDS=30
