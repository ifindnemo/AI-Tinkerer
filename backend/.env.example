OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional: route every agent through Inworld Router (OpenAI-compatible) instead of OpenAI.
# The key is the Base64 credential from the Inworld Portal; LLMMODEL e.g. openai/gpt-5-mini or inworld/<router-id>.
INWORLD_API_KEY=
LLMMODEL=
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
WEATHER_API_TIMEOUT_SECONDS=5
LOCATIONIQ_ACCESS_TOKEN=
GOOGLE_CALENDAR_CREDENTIALS_FILE=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIME_ZONE=Asia/Ho_Chi_Minh
DATABASE_PATH=vehicle_guardian.db
INCIDENT_MEMORY_TTL_MINUTES=60
# Live OBD analysis: "openai" (default) or "rules" (no LLM call, rule-only assessment)
AGENT_MODE=openai
# Seconds before a slow LLM reply is abandoned for the rule-only assessment
AGENT_TIMEOUT_SECONDS=45
# "off" skips LocationIQ garage lookups (offline demos, tests)
EXTERNAL_TOOLS=on
# Detector thresholds; set per car after recording a normal drive (some engines run near 100–105 °C)
COOLANT_WARN_C=105
COOLANT_RISE_PER_MIN=3
# Driver-attention alerts: seconds to wait for the agent wording before using the rule text
DRIVER_AGENT_TIMEOUT_SECONDS=8
